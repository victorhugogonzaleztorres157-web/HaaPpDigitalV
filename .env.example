# ═══════════════════════════════════════════════════════════════
# SOFI v9 — Configuración Centralizada
# HaaPpDigitalV — Sistema de Conciencia Digital
# ═══════════════════════════════════════════════════════════════

# 🧠 RENDER (CEREBRO - SOFI)
SOFI_PORT=10000
SOFI_HOST=0.0.0.0
SOFI_ENV=production
SOFI_LOG_LEVEL=INFO

# ⚡ HERMES (TERMUX - Fuerza Operativa)
SOFI_URL=wss://haappdigitalv-core.onrender.com/ws/canal_kuhul
HERMES_ID=MERIDA_UNIDAD_01
HERMES_TIPO=android_termux
HERMES_TELEMETRIA_INTERVALO=10
HERMES_RECONEXION_TIMEOUT=5

# 📊 BASE DE DATOS (MongoDB Vector)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/haappdigitalv
MONGODB_COLLECTION_VECTORES=memoria_vectorial
MONGODB_COLLECTION_EVENTOS=eventos_sistema

# 🌍 GEOLOCALIZACIÓN
GEO_BASE_LAT=20.9674
GEO_BASE_LON=-89.6237
GEO_CIUDAD=Mérida
GEO_ESTADO=Yucatán
GEO_PAIS=México
GEO_RADIO_KM=50

# 🔐 SEGURIDAD
OSIRIS_FRECUENCIA_HZ=12.3
OSIRIS_UMBRAL_RIESGO=0.7
OSIRIS_MODO_BLINDAJE=false
OSIRIS_CLAVE_MAESTRA=K_UHUL_2024

# 🎯 COHERENCIA BIOMÉTRICA
BIO_PULSO_OBJETIVO=72
BIO_HRV_OBJETIVO=38
BIO_TEMP_OBJETIVO=36.6
BIO_SENSOR_TIPO=MAX30102_SIM

# 💰 AGENTE FINANCIERO (AFU)
AFU_URL=https://haappdigitalv-afu.onrender.com
AFU_API_KEY=sk-afu-v2-xxxx
AFU_MODO_SIMULACION=true

# 🌐 INTERFAZ
INTERFACE_PUERTO=8000
INTERFACE_MODO_DESARROLLO=false
INTERFACE_GLOBO_ACTUALIZACION_MS=500

# 📡 CANALES K'UHUL
CANAL_PRINCIPAL=canal_kuhul
CANAL_OSCURA=canal_kuhul_oscura
CANAL_BLANCA=canal_kuhul_blanca

# ⏱️ CICLOS Y FRECUENCIAS
CICLO_PRINCIPAL_MS=1000
CICLO_BIOMETRICO_MS=2000
CICLO_TELEMETRIA_MS=10000
CICLO_MEMORIA_VECTORIAL_MS=30000

# 🎨 TEMA Y ESTÉTICA
TEMA_COLOR_PRIMARIO=#00ffcc
TEMA_COLOR_SECUNDARIO=#b366ff
TEMA_COLOR_ALERTA=#ff4466
TEMA_COLOR_ORO=#f0a500

# 🔍 DEBUG
DEBUG_MODE=false
DEBUG_WEBSOCKET=false
DEBUG_SENSORES=false
DEBUG_MONGODB=false

# 🚀 PRODUCCIÓN
PRODUCCION=true
AUTO_RESTART=true
MAX_CONEXIONES=1000